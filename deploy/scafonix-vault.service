[Unit]
Description=scafonix Vault 2nd Inspector Service
After=network.target

[Service]
Type=simple
User=vault
WorkingDirectory=/opt/scafonix-vault
ExecStart=/opt/scafonix-vault/scafonix-server
Restart=always
RestartSec=3
Environment=PORT=3000
Environment=RUST_LOG=info
Environment=DATABASE_PATH=/var/lib/scafonix-vault/vault.db

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/scafonix-vault
PrivateTmp=true

[Install]
WantedBy=multi-user.target
